{
  "name": "vip-motors-atelier",
  "version": "1.1.0",
  "private": true,
  "description": "A dependency-light bilingual luxury automotive concierge landing experience.",
  "scripts": {
    "check": "node --check script.js && node --test tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:performance": "playwright test --project=chromium --grep @performance",
    "test": "npm run check && npm run test:e2e",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5"
  }
}
